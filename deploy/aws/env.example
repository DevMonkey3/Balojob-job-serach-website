# Example of /etc/bhalojob/bhalojob.env, the one settings file of the server.
#
# You normally never write this file by hand: deploy/aws/setup.sh creates it
# with strong random secrets, readable by root only, and never changes the
# secrets again. This example explains every line and holds NO real values.
#
# Rules of the file: one NAME=value per line, no spaces around "=", no quotes.
# After changing a line run:  sudo bash deploy/aws/update.sh --no-pull
#
# KEEP A COPY OF THE REAL FILE OUTSIDE THE SERVER (a password manager is ideal).

# The site's host name. Caddy gets the HTTPS certificate for exactly this name,
# so its DNS "A" record must point at the server. Change it with:
#   sudo bash deploy/aws/setup.sh new-name.example.com
DOMAIN=example.com

# PostgreSQL. The user, database and password are created the first time the
# database container starts. Changing them here later does NOT change the
# existing database, it only breaks the login. Letters and digits only in the
# password, because it is also part of DATABASE_URL.
POSTGRES_USER=bhalojob
POSTGRES_DB=bhalojob
POSTGRES_PASSWORD=CHANGE_ME_48_random_letters_and_digits

# How the app and the migration job reach the database. "db" is the database
# container's name inside Docker. Must repeat the user, password and database above.
DATABASE_URL=postgresql://bhalojob:CHANGE_ME_48_random_letters_and_digits@db:5432/bhalojob?schema=public

# Encrypts passport numbers before they are stored (AES-256-GCM): 32 random
# bytes in base64, as made by `openssl rand -base64 32`.
# NEVER change or lose it: the numbers already stored could not be read any more.
APP_ENCRYPTION_KEY=CHANGE_ME_32_random_bytes_in_base64

# The secret address of the staff console: https://DOMAIN/<ADMIN_PATH>/login
# One URL segment (letters, digits, "-", "_"; 3 to 64 characters). setup.sh
# makes "console-" plus 12 random characters. /admin itself answers 404.
ADMIN_PATH=console-CHANGE_ME

# Most database connections the app opens at once. 5 is right for a 2 GB server.
DATABASE_POOL_MAX=5

# Build workers for `next build`. 1 keeps memory low on a 2 GB server.
NEXT_BUILD_CPUS=1

# Nightly backups (deploy/aws/backup.sh): where they go on the server and for
# how many days they are kept.
BACKUP_DIR=/var/backups/bhalojob
BACKUP_KEEP_DAYS=14

# Optional. An S3 bucket name (or bucket/folder) that receives a copy of every
# backup. Needs an IAM role on the server and the AWS CLI; see "Copy the
# backups to S3" in docs/aws-deploy.md. Empty = backups stay on the server only.
BACKUP_S3_BUCKET=
