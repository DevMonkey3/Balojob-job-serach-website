# Keeps the Docker build small, and keeps secrets, local data and demo data out
# of every image. Everything the build needs stays in: package files, src/,
# prisma/, the config files, db/seed.sql and deploy/aws/docker/.

# Version control and editors
.git
.gitignore
.gitattributes
.vscode
.idea

# Installed or built inside the image
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
src/generated

# Secrets and local-only files (the server's .env link to /etc/bhalojob included)
.env*
*.pem
DEMO-LOGIN.txt

# Uploaded files of the local storage driver
storage

# Demo rows. Must never reach a production image.
db/sample-data.sql

# Not needed to build or run
docs
*.md
LICENSE
Dockerfile
.dockerignore
docker-compose.yml
deploy/aws/*.sh
deploy/aws/*.example
deploy/aws/caddy
